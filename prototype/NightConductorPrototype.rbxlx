		panel.Position = wide and UDim2.fromScale(0.36, 0.12) or UDim2.fromScale(0.02, 0.12)
		panel.Size = wide and UDim2.fromScale(0.62, 0.88) or UDim2.fromScale(0.96, 0.88)

		header.Size = UDim2.new(1, 0, 0, 48)
