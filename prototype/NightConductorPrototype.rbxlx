      <string name="Name">Server</string>
    </Properties>
  <Item class="Script" referent="RBX6">
    <Properties>
      <string name="Name">Bootstrap</string>
      <ProtectedString name="Source"><![CDATA[local GameService = require(script.Parent:WaitForChild("GameService"))

print("[NightConductor] Bootstrap v7 loaded")
GameService.init()
]]></ProtectedString>
    </Properties>
  </Item>
  <Item class="ModuleScript" referent="RBX7">
    <Properties>
      <string name="Name">GameService</string>
      <ProtectedString name="Source"><![CDATA[-- Server-authoritative prototype flow: 6 passengers -> tunnel -> results.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local PassengerFactory = require(script.Parent:WaitForChild("PassengerFactory"))
local WorldBuilder = require(script.Parent:WaitForChild("WorldBuilder"))

local GameService = {}

local activePlayer = nil
local shiftRunning = false
local currentPassenger = nil
local currentModel = nil
local locked = false
local held = false
local pendingDecision = nil
local tunnelChoice = nil
local tunnelOpen = false
local shiftTools = {}
local toolUses = {}
local runCounts = {}

local decisionSignal = Instance.new("BindableEvent")
local tunnelSignal = Instance.new("BindableEvent")

local validTunnelChoices = {}
for _, choice in ipairs(Config.TunnelChoices) do
	validTunnelChoices[choice.id] = true
end

local function send(player, payload)
	if player and player.Parent then
		Remotes.GameEvent:FireClient(player, payload)
	end
end

local function anomalyName(data)
	if data and data.isAnomaly and data.anomalyId and Config.Anomalies[data.anomalyId] then
		return Config.Anomalies[data.anomalyId].name
	end
	return nil
end

local function waitForDecision(timeout)
	local done = false
	local connection = decisionSignal.Event:Connect(function()
		done = true
	end)

	local started = os.clock()
	while not done and os.clock() - started < timeout do
		if not activePlayer or not activePlayer.Parent then
			break
		end
		task.wait(0.1)
	end

	connection:Disconnect()
	return done
end

local function waitForTunnel(timeout)
	local done = false
	local connection = tunnelSignal.Event:Connect(function()
		done = true
	end)

	local started = os.clock()
	while not done and os.clock() - started < timeout do
		if not activePlayer or not activePlayer.Parent then
			break
		end
		task.wait(0.1)
	end

	connection:Disconnect()
	return done
end

local function evaluateDecision(data, decision, stats)
	local correct = false
	local message

	if decision == "admit" then
		if data.isAnomaly then
			stats.anomaliesOnBoard = stats.anomaliesOnBoard + 1
			stats.mistakes = stats.mistakes + 1
			message = "Аномалия села в поезд. Она уже в вагоне."
		else
			stats.correct = stats.correct + 1
			correct = true
			message = "Пассажир сел. Пока всё спокойно."
		end
	elseif decision == "deny" then
		if data.isAnomaly then
			stats.caught = stats.caught + 1
			stats.correct = stats.correct + 1
			correct = true
			message = "Верно. Пассажир растворился в тени."
		else
			stats.mistakes = stats.mistakes + 1
			message = "Вы отказали невиновному. Он ушёл с обидой."
		end
	end

	return correct, message
end

local function runTunnel(player, stats)
	if stats.anomaliesOnBoard > 0 then
		tunnelChoice = nil
		tunnelOpen = true
		send(player, {
			type = "tunnel",
			title = "ЧЁРНАЯ МИЛЯ",
			text = "Аномалия на борту. Свет гаснет. У тебя 12 секунд, чтобы выбрать действие.",
			choices = Config.TunnelChoices,
		})

		waitForTunnel(14)
		tunnelOpen = false

		local choice = tunnelChoice or "hide"
		if not validTunnelChoices[choice] then
			choice = "hide"
		end

		local chances = {
			expose = 0.55,
			contain = 0.6,
			brake = 0.5,
			hide = 0.3,
		}
		if choice == "expose" and shiftTools.mirror then
			chances.expose = chances.expose + 0.2
		end

		local success = math.random() < chances[choice]
		local text
		if success then
			stats.caught = stats.caught + stats.anomaliesOnBoard
			if choice == "expose" then
				text = "Зеркало вспыхнуло. Аномалия закричала и рассыпалась. Поезд вышел из тоннеля."
			elseif choice == "contain" then
				text = "Вы заперли вагон. Что-то стучало всю дорогу, но поезд цел."
			elseif choice == "brake" then
				text = "Стоп-кран завизжал. Поезд встал в тоннеле. Аномалия не успела."
			else
				text = "Вы переждали в тамбуре. Аномалия прошла мимо."
			end
		else
			stats.mistakes = stats.mistakes + 1
			text = "Аномалия добралась до Сердца. Поезд потерял вагон. Смена окончена."
		end

		send(player, {
			type = "tunnelResult",
			success = success,
			text = text,
			choice = choice,
		})
		task.wait(3.2)
		return success
	end

	send(player, {
		type = "quiet",
		title = "ТИХАЯ МИЛЯ",
		text = "Аномалий нет. Поезд проходит станцию, которой нет на карте. Кот смотрит в окно.",
	})
	task.wait(3)
	return true
end

local function runShift(player)
	WorldBuilder.build()
	shiftTools = {}

	local character = player.Character or player.CharacterAdded:Wait()
	task.wait(0.3)
	character:PivotTo(WorldBuilder.spawnCFrame)

	send(player, { type = "reset" })

	local runNumber = (runCounts[player] or 0) + 1
	runCounts[player] = runNumber
	local seed = runNumber == 1 and 1 or math.random(2, 1000000000)
	local plan = PassengerFactory.buildPlan(seed)

	local stats = {
		correct = 0,
		mistakes = 0,
		caught = 0,
		anomaliesOnBoard = 0,
		total = Config.TotalPassengers,
	}

	for index = 1, Config.TotalPassengers do
		if not player.Parent then
			return
		end

		local data = PassengerFactory.create(index, seed, plan[index])
		local model = WorldBuilder.spawnPassenger(data)
		currentPassenger = data
		currentModel = model
		locked = false
		held = false
		pendingDecision = nil
		toolUses = {}

		send(player, {
			type = "progress",
			index = index,
			total = Config.TotalPassengers,
		})
		task.wait(0.25)

		WorldBuilder.movePassenger(model, WorldBuilder.boothCFrame, 1.1)
		local publicData = PassengerFactory.publicData(data)
		if runNumber == 1 then
			local tutorial = Config.Tutorial[index]
			if tutorial then
				publicData.tutorial = {
					index = index,
					text = tutorial.text,
					tool = tutorial.tool,
					decision = tutorial.decision,
				}
			end
		end
		send(player, {
			type = "passenger",
			data = publicData,
		})

		local gotDecision = waitForDecision(60)
		if not gotDecision then
			if currentModel then
				WorldBuilder.removePassenger(currentModel)
			end
			send(player, {
				type = "result",
				stars = 1,
				payout = 0,
				tunnelSuccess = false,
				stats = {
					correct = stats.correct,
					mistakes = stats.mistakes,
					caught = stats.caught,
					missed = stats.anomaliesOnBoard,
					total = stats.total,
				},
			})
			return
		end

		local decision = pendingDecision
		pendingDecision = nil
		if decision ~= "admit" and decision ~= "deny" then
			decision = "deny"
		end

		local correct, message = evaluateDecision(data, decision, stats)
		local name = anomalyName(data)
		local hint = data.isAnomaly and data.anomalyId and Config.Anomalies[data.anomalyId] and Config.Anomalies[data.anomalyId].hint or nil
		if not correct and not data.isAnomaly then
			hint = "Все документы и фото совпадали. Невиновных нужно пропускать."
		end

		send(player, {
			type = "feedback",
			kind = correct and "good" or "bad",
			text = message,
			anomalyName = name,
			hint = hint,
			correct = correct,
		})

		if decision == "admit" then
			WorldBuilder.movePassenger(model, WorldBuilder.trainDoorCFrame, 1.0)
			task.wait(0.9)
		else
			WorldBuilder.movePassenger(model, WorldBuilder.exitCFrame, 1.0)
			task.wait(0.9)
		end

		WorldBuilder.removePassenger(model)
		currentPassenger = nil
		currentModel = nil
		locked = false
		held = false
		task.wait(0.9)
	end

	local tunnelSuccess = runTunnel(player, stats)
	if not player.Parent then
		return
	end

	local stars = 1
	if stats.mistakes == 0 then
		stars = 3
	elseif stats.mistakes <= 2 then
		stars = 2
	end
	if stats.anomaliesOnBoard > 0 and not tunnelSuccess then
		stars = math.min(stars, 1)
	end

	local payout = 100 + stats.correct * 25 + stats.caught * 50 + (tunnelSuccess and 150 or 0) - stats.mistakes * 15
	payout = math.max(0, payout)

	send(player, {
		type = "result",
		stars = stars,
		payout = payout,
		stats = {
			correct = stats.correct,
			mistakes = stats.mistakes,
			caught = stats.caught,
			missed = stats.anomaliesOnBoard,
			total = stats.total,
		},
		tunnelSuccess = tunnelSuccess,
	})
end

local function startShift(player)
	if shiftRunning or not player or not player.Parent then
		return
	end

	shiftRunning = true
	activePlayer = player

	task.spawn(function()
		local ok, err = pcall(runShift, player)
		if not ok then
			warn("[NightConductor] " .. tostring(err))
		end
		shiftRunning = false
	end)
end

function GameService.init()
	WorldBuilder.build()

	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(function()
			task.wait(1)
			startShift(player)
		end)
	end

	Players.PlayerAdded:Connect(function(player)
		task.spawn(function()
			task.wait(2)
			startShift(player)
		end)
	end)

	Players.PlayerRemoving:Connect(function(player)
		runCounts[player] = nil
		if activePlayer == player then
			activePlayer = nil
			currentPassenger = nil
			currentModel = nil
			locked = true
			tunnelOpen = false
		end

		task.delay(1.5, function()
			if not shiftRunning then
				local nextPlayer = Players:GetPlayers()[1]
				if nextPlayer then
					startShift(nextPlayer)
				end
			end
		end)
	end)

	Remotes.Inspect.OnServerInvoke = function(player, toolId)
		if player ~= activePlayer or not currentPassenger or locked then
			return { ok = false, text = "Сейчас нельзя." }
		end
		if type(toolId) ~= "string" then
			return { ok = false, text = "Неизвестный инструмент." }
		end

		local limits = {
			mirror = 2,
			lamp = 2,
			magnifier = 2,
			look = 2,
			compass = 1,
			cat = 1,
		}
		local used = (toolUses[toolId] or 0) + 1
		if used > (limits[toolId] or 2) then
			return { ok = false, text = "Инструмент уже дал всё, что мог. Попробуй другой." }
		end
		toolUses[toolId] = used

		shiftTools[toolId] = true
		local data = currentPassenger

		if toolId == "mirror" then
			if data.noReflection then
				return { ok = true, text = "В зеркале на месте пассажира — пусто. Только стена." }
			end
			return { ok = true, text = "Отражение совпадает. Пассажир выглядит обычно." }
		elseif toolId == "lamp" then
			if data.shadowWrong then
				return { ok = true, text = "Тень падает в сторону лампы, а не от неё. Это неправильно." }
			end
			return { ok = true, text = "Тень на месте, пламя ровное. Холода нет." }
		elseif toolId == "magnifier" then
			if data.ticket.date ~= Config.Today then
				return { ok = true, text = "Дата на билете: " .. data.ticket.date .. ". Сегодня " .. Config.Today .. ". Это несоответствие." }
			end
			if data.extraFinger then
				return { ok = true, text = "На правой руке шесть пальцев. Перчатка не скрывает лишний." }
			end
			if data.passport.photoHatName ~= data.appearance.hatName then
				return { ok = true, text = "На фото — " .. data.passport.photoHatName .. " шляпа. На пассажире — " .. data.appearance.hatName .. "." }
			end
			return { ok = true, text = "Печать, дата и подпись выглядят обычно." }
		elseif toolId == "compass" then
			if data.isAnomaly then
				return { ok = true, text = "Стрелка дёргается и крутится. Рядом аномалия." }
			end
			return { ok = true, text = "Стрелка спокойна." }
		elseif toolId == "cat" then
			if data.isAnomaly then
				return { ok = true, text = "Кот шипит и прячется за стойку." }
			end
			return { ok = true, text = "Кот мурчит и трётся о ногу." }
		elseif toolId == "look" then
			return { ok = true, text = "На пассажире " .. data.appearance.hatName .. " шляпа. Глаза " .. data.appearance.eyeColor .. ". Он выглядит спокойным." }
		end

		return { ok = false, text = "Инструмент не отвечает." }
	end

	Remotes.Ask.OnServerInvoke = function(player, questionId)
		if player ~= activePlayer or not currentPassenger or locked then
			return { ok = false, text = "Сейчас нельзя." }
		end

		local answer = currentPassenger.answers[questionId]
		if answer then
			return { ok = true, text = answer }
		end
		return { ok = false, text = "Пассажир не понял вопрос." }
	end

	Remotes.Decide.OnServerEvent:Connect(function(player, decision)
		if player ~= activePlayer or not currentPassenger or locked then
			return
		end

		if decision == "hold" then
			if held then
				send(player, { type = "feedback", kind = "info", text = "Пассажир уже задержан. Проверьте документы ещё раз." })
			else
				held = true
				send(player, { type = "feedback", kind = "info", text = "Пассажир ждёт в стороне. Можно использовать инструменты ещё раз." })
			end
			return
		end

		if decision ~= "admit" and decision ~= "deny" then
			return
		end

		locked = true
		pendingDecision = decision
		decisionSignal:Fire()
	end)

	Remotes.TunnelChoice.OnServerEvent:Connect(function(player, choice)
		if player ~= activePlayer or not tunnelOpen or tunnelChoice ~= nil then
			return
		end
		if not validTunnelChoices[choice] then
			return
		end
		tunnelChoice = choice
		tunnelSignal:Fire()
	end)

	Remotes.Restart.OnServerEvent:Connect(function(player)
		if player ~= activePlayer then
			return
		end

		task.spawn(function()
			local started = os.clock()
			while shiftRunning and os.clock() - started < 3 do
				task.wait(0.1)
			end
			if player == activePlayer and not shiftRunning then
				startShift(player)
			end
		end)
	end)
end

return GameService
]]></ProtectedString>
    </Properties>
  </Item>
  <Item class="ModuleScript" referent="RBX8">
    <Properties>
      <string name="Name">PassengerFactory</string>
      <ProtectedString name="Source"><![CDATA[-- Creates deterministic passenger cases for the prototype.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local PassengerFactory = {}

local function pick(rng, list)
	return list[rng:NextInteger(1, #list)]
end

local function makeTicketNumber(rng)
	return tostring(rng:NextInteger(10000, 99999))
end

local function makePassportNumber(rng)
	return "NC-" .. tostring(rng:NextInteger(1000, 9999))
end

local function makeColor(rng)
	return Color3.fromRGB(rng:NextInteger(35, 220), rng:NextInteger(35, 220), rng:NextInteger(35, 220))
end

local function cloneTable(value)
	if type(value) ~= "table" then
		return value
	end
	local result = {}
	for key, child in pairs(value) do
		result[key] = cloneTable(child)
	end
	return result
end

-- The first shift is scripted so the player learns each tool once.
-- Later shifts get 2-3 random anomalies.
function PassengerFactory.buildPlan(seed)
	if seed == 1 then
		return {
			[1] = nil,
			[2] = "wrong_date",
			[3] = "wrong_shadow",
			[4] = "no_reflection",
			[5] = "six_fingers",
			[6] = nil,
		}
	end

	local rng = Random.new(seed)
	local anomalyIds = { "wrong_date", "wrong_shadow", "no_reflection", "six_fingers", "photo_mismatch" }
	for index = #anomalyIds, 2, -1 do
		local swap = rng:NextInteger(1, index)
		anomalyIds[index], anomalyIds[swap] = anomalyIds[swap], anomalyIds[index]
	end

	local indices = { 1, 2, 3, 4, 5, 6 }
	for index = #indices, 2, -1 do
		local swap = rng:NextInteger(1, index)
		indices[index], indices[swap] = indices[swap], indices[index]
	end

	local count = rng:NextInteger(2, 3)
	local plan = {}
	for index = 1, count do
		plan[indices[index]] = anomalyIds[index]
	end
	return plan
end

function PassengerFactory.create(index, seed, anomalyId)
	local rng = Random.new(seed + index * 7919)
	local name = pick(rng, Config.PassengerNames)
	local destination = pick(rng, Config.Destinations)
	local origin = pick(rng, Config.Origins)
	local contents = pick(rng, Config.LuggageContents)
	local hat = pick(rng, Config.HatColors)
	local eyeColor = pick(rng, Config.EyeColors)
	local seat = tostring(index + 2) .. (index % 2 == 0 and "A" or "B")
	local class = index % 3 == 0 and "first" or "second"
	local ticketNumber = makeTicketNumber(rng)
	local passportNumber = makePassportNumber(rng)
	local price = rng:NextInteger(12, 48)

	local data = {
		id = "P" .. tostring(index),
		name = name,
		age = rng:NextInteger(18, 67),
		species = "human",
		seat = seat,
		class = class,
		destination = destination,
		rule = Config.Rule,
		isAnomaly = false,
		anomalyId = nil,
		extraFinger = false,
		noReflection = false,
		shadowWrong = false,
		appearance = {
			shirtColor = makeColor(rng),
			pantsColor = makeColor(rng),
			skinColor = Color3.fromRGB(rng:NextInteger(120, 220), rng:NextInteger(90, 180), rng:NextInteger(70, 150)),
			hatColor = hat.color,
			hatName = hat.name,
			eyeColor = eyeColor,
		},
		ticket = {
			number = ticketNumber,
			from = "Станция 0",
			to = destination,
			date = Config.Today,
			seat = seat,
			class = class,
			price = price,
			stamp = "LIVE",
		},
		passport = {
			number = passportNumber,
			origin = origin,
			seal = "СОЛОВЕЙ",
			photoHatName = hat.name,
			eyeColor = eyeColor,
		},
		luggage = {
			tag = "T-" .. ticketNumber,
			weight = rng:NextInteger(4, 24),
			contents = contents,
		},
		answers = {
			destination = "На " .. destination .. ".",
			luggage = "Там " .. contents .. ".",
			name = "Меня зовут " .. name .. ".",
		},
	}

	if anomalyId == "wrong_date" then
		data.isAnomaly = true
		data.anomalyId = anomalyId
		data.ticket.date = "12.04.1912"
		data.ticket.stamp = "ARCHIVE"
		data.answers.destination = "В 1912-й. Там меня ждут."
	elseif anomalyId == "no_reflection" then
		data.isAnomaly = true
		data.anomalyId = anomalyId
		data.noReflection = true
		data.answers.name = "Я... не помню."
	elseif anomalyId == "wrong_shadow" then
		data.isAnomaly = true
		data.anomalyId = anomalyId
		data.shadowWrong = true
	elseif anomalyId == "six_fingers" then
		data.isAnomaly = true
		data.anomalyId = anomalyId
		data.extraFinger = true
		data.answers.luggage = "Перчатки. Одна пара."
	elseif anomalyId == "photo_mismatch" then
		data.isAnomaly = true
		data.anomalyId = anomalyId
		local otherHat = pick(rng, Config.HatColors)
		while otherHat.name == hat.name do
			otherHat = pick(rng, Config.HatColors)
		end
		data.passport.photoHatName = otherHat.name
	end

	return data
end

function PassengerFactory.publicData(data)
	return {
		id = data.id,
		name = data.name,
		age = data.age,
		species = data.species,
		seat = data.seat,
		class = data.class,
		destination = data.destination,
		rule = data.rule,
		ticket = cloneTable(data.ticket),
		passport = cloneTable(data.passport),
		luggage = cloneTable(data.luggage),
		appearance = cloneTable(data.appearance),
	}
end

return PassengerFactory
]]></ProtectedString>
    </Properties>
  </Item>
  <Item class="ModuleScript" referent="RBX9">
    <Properties>
      <string name="Name">WorldBuilder</string>
      <ProtectedString name="Source"><![CDATA[-- Builds the prototype station, train, booth and passenger models from primitives.
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")

local WorldBuilder = {}

local WORLD_NAME = "NightConductorWorld"
local PASSENGER_FOLDER = "NightConductorPassengers"

WorldBuilder.spawnCFrame = CFrame.lookAt(Vector3.new(-8, 3, -18), Vector3.new(-8, 3, -12))
WorldBuilder.boothCFrame = CFrame.lookAt(Vector3.new(-8, 4, -12), Vector3.new(-8, 4, -18))
WorldBuilder.trainDoorCFrame = CFrame.lookAt(Vector3.new(-8, 4, -4.8), Vector3.new(-8, 4, 0))
WorldBuilder.exitCFrame = CFrame.lookAt(Vector3.new(20, 4, -18), Vector3.new(30, 4, -18))
WorldBuilder.startCFrame = CFrame.lookAt(Vector3.new(20, 4, -12), Vector3.new(-8, 4, -12))

local function part(parent, name, size, cframe, color, material, transparency, canCollide)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cframe
	p.Anchored = true
	p.CanCollide = canCollide ~= false
	p.Color = color or Color3.fromRGB(180, 180, 180)
	p.Material = material or Enum.Material.SmoothPlastic
	p.Transparency = transparency or 0
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function cylinder(parent, name, size, cframe, color, material)
	local p = part(parent, name, size, cframe, color, material or Enum.Material.Metal, 0, false)
	p.Shape = Enum.PartType.Cylinder
	return p
end

local function addPointLight(parent, color, brightness, range)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Brightness = brightness
	light.Range = range
	light.Shadows = false
	light.Parent = parent
	return light
end

local function billboard(parent, text, offset, size)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Label"
	gui.Size = size or UDim2.fromOffset(360, 100)
	gui.StudsOffset = offset or Vector3.new(0, 2.5, 0)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.Parent = parent

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = Color3.fromRGB(255, 220, 150)
	label.TextStrokeTransparency = 0.6
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.Parent = gui
	return gui
end

local function buildLighting()
	Lighting.ClockTime = 0
	Lighting.Brightness = 1.4
	Lighting.Ambient = Color3.fromRGB(18, 22, 34)
	Lighting.OutdoorAmbient = Color3.fromRGB(25, 32, 50)
	Lighting.FogEnd = 220
	Lighting.FogColor = Color3.fromRGB(10, 12, 22)
	Lighting.EnvironmentDiffuseScale = 0.45
	Lighting.EnvironmentSpecularScale = 0.2

	for _, child in ipairs(Lighting:GetChildren()) do
		if child.Name == "PrototypeAtmosphere" or child.Name == "PrototypeBloom" or child.Name == "PrototypeColor" then
			child:Destroy()
		end
	end

	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Name = "PrototypeAtmosphere"
	atmosphere.Density = 0.38
	atmosphere.Haze = 2
	atmosphere.Glare = 0.15
	atmosphere.Color = Color3.fromRGB(120, 145, 190)
	atmosphere.Decay = Color3.fromRGB(70, 80, 120)
	atmosphere.Parent = Lighting

	local bloom = Instance.new("BloomEffect")
	bloom.Name = "PrototypeBloom"
	bloom.Intensity = 0.45
	bloom.Size = 24
	bloom.Threshold = 0.9
	bloom.Parent = Lighting

	local color = Instance.new("ColorCorrectionEffect")
	color.Name = "PrototypeColor"
	color.TintColor = Color3.fromRGB(230, 238, 255)
	color.Contrast = 0.05
	color.Saturation = -0.08
	color.Parent = Lighting
end

local function buildTrain(world)
	local body = part(world, "TrainFloor", Vector3.new(60, 0.5, 14), CFrame.new(0, 1.25, 4), Color3.fromRGB(70, 45, 30), Enum.Material.WoodPlanks)
	body.CanCollide = true

	part(world, "TrainLeftWallA", Vector3.new(18, 6, 0.4), CFrame.new(-21, 4, -3), Color3.fromRGB(25, 70, 52), Enum.Material.Wood)
	part(world, "TrainLeftWallB", Vector3.new(34, 6, 0.4), CFrame.new(13, 4, -3), Color3.fromRGB(25, 70, 52), Enum.Material.Wood)
	part(world, "TrainRightWall", Vector3.new(60, 6, 0.4), CFrame.new(0, 4, 11), Color3.fromRGB(25, 70, 52), Enum.Material.Wood)
	part(world, "TrainEndA", Vector3.new(0.4, 6, 14), CFrame.new(-30, 4, 4), Color3.fromRGB(25, 70, 52), Enum.Material.Wood)
	part(world, "TrainEndB", Vector3.new(0.4, 6, 14), CFrame.new(30, 4, 4), Color3.fromRGB(25, 70, 52), Enum.Material.Wood)
	part(world, "TrainRoof", Vector3.new(60, 0.5, 14), CFrame.new(0, 7.25, 4), Color3.fromRGB(18, 48, 38), Enum.Material.Wood)

	for index = 1, 5 do
		local x = -24 + (index - 1) * 12
		part(world, "Window" .. index, Vector3.new(7, 3, 0.2), CFrame.new(x, 4.4, -3.24), Color3.fromRGB(130, 180, 210), Enum.Material.Glass, 0.55, false)
	end

	for _, x in ipairs({ -24, -12, 0, 12, 24 }) do
		for _, z in ipairs({ -2.8, 10.8 }) do
			cylinder(world, "Wheel", Vector3.new(0.8, 2.2, 2.2), CFrame.new(x, 1, z) * CFrame.Angles(0, math.rad(90), 0), Color3.fromRGB(30, 30, 30))
		end
	end

	part(world, "BrassTrimTop", Vector3.new(60, 0.2, 0.25), CFrame.new(0, 6.8, -3.2), Color3.fromRGB(190, 150, 70), Enum.Material.Metal)
	part(world, "BrassTrimBottom", Vector3.new(60, 0.2, 0.25), CFrame.new(0, 1.2, -3.2), Color3.fromRGB(190, 150, 70), Enum.Material.Metal)

	local door = part(world, "TrainDoor", Vector3.new(8, 5.5, 0.3), CFrame.new(-8, 3.75, -3.2), Color3.fromRGB(190, 150, 70), Enum.Material.Metal)
	door.Transparency = 0.35
	part(world, "TrainStep", Vector3.new(8, 0.5, 3), CFrame.new(-8, 0.55, -4.8), Color3.fromRGB(80, 60, 40), Enum.Material.Wood)

	local chimney = cylinder(world, "Chimney", Vector3.new(1.4, 2.8, 1.4), CFrame.new(-26, 9, 4) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(40, 40, 45))
	chimney.CanCollide = false

	local headlight = part(world, "Headlight", Vector3.new(1.2, 1.2, 0.4), CFrame.new(-31, 5, 4), Color3.fromRGB(255, 220, 140), Enum.Material.Neon)
	addPointLight(headlight, Color3.fromRGB(255, 210, 130), 2, 30)

	for index = 1, 5 do
		local x = -22 + (index - 1) * 10
		part(world, "Seat" .. index, Vector3.new(7, 0.5, 2.5), CFrame.new(x, 2.1, 9.5), Color3.fromRGB(110, 35, 45), Enum.Material.Fabric)
		part(world, "SeatBack" .. index, Vector3.new(7, 3, 0.4), CFrame.new(x, 3.5, 10.7), Color3.fromRGB(90, 25, 35), Enum.Material.Fabric)
	end

	for _, x in ipairs({ -20, 0, 20 }) do
		local lamp = part(world, "TrainLamp", Vector3.new(1, 0.25, 1), CFrame.new(x, 6.95, 4), Color3.fromRGB(255, 210, 140), Enum.Material.Neon)
		addPointLight(lamp, Color3.fromRGB(255, 190, 110), 1.2, 18)
	end
end

local function buildStation(world)
	part(world, "Platform", Vector3.new(90, 1, 26), CFrame.new(0, 0.5, -14), Color3.fromRGB(90, 85, 80), Enum.Material.Concrete)
	part(world, "SafetyLine", Vector3.new(90, 0.08, 0.5), CFrame.new(0, 1.05, -1.6), Color3.fromRGB(230, 190, 70), Enum.Material.Neon, 0, false)

	for _, x in ipairs({ -30, 30 }) do
		local pole = part(world, "LampPole", Vector3.new(0.5, 7, 0.5), CFrame.new(x, 4, -12), Color3.fromRGB(35, 35, 40), Enum.Material.Metal)
		pole.CanCollide = false
		local lamp = part(world, "PlatformLamp", Vector3.new(1.4, 1.4, 1.4), CFrame.new(x, 7.6, -12), Color3.fromRGB(255, 210, 140), Enum.Material.Neon)
		lamp.CanCollide = false
		addPointLight(lamp, Color3.fromRGB(255, 190, 110), 2.2, 26)
	end

	local canopy = part(world, "Canopy", Vector3.new(44, 0.5, 16), CFrame.new(-4, 10, -18), Color3.fromRGB(30, 45, 40), Enum.Material.Metal)
	canopy.CanCollide = false
	for _, x in ipairs({ -24, 16 }) do
		for _, z in ipairs({ -24, -10.5 }) do
			part(world, "CanopyPillar", Vector3.new(0.5, 9, 0.5), CFrame.new(x, 5.2, z), Color3.fromRGB(40, 40, 45), Enum.Material.Metal)
		end
	end

	local signPart = part(world, "StationSign", Vector3.new(14, 3, 0.5), CFrame.new(0, 8, -24), Color3.fromRGB(30, 40, 35), Enum.Material.Wood)
	signPart.CanCollide = false
	billboard(signPart, "STATION 0\nLAST LIGHT", Vector3.new(0, 0, 0), UDim2.fromOffset(520, 130))

	local boothSign = part(world, "BoothSign", Vector3.new(5, 1.2, 0.3), CFrame.new(-8, 5.9, -15), Color3.fromRGB(30, 40, 35), Enum.Material.Wood)
	boothSign.CanCollide = false
	billboard(boothSign, "CONDUCTOR", Vector3.new(0, 0, 0), UDim2.fromOffset(300, 70))

	local desk = part(world, "Desk", Vector3.new(7, 1.3, 2.6), CFrame.new(-8, 1.15, -15), Color3.fromRGB(80, 52, 32), Enum.Material.Wood)
	desk.CanCollide = true
	part(world, "DeskTop", Vector3.new(7.2, 0.2, 2.8), CFrame.new(-8, 1.9, -15), Color3.fromRGB(110, 75, 45), Enum.Material.Wood)
	part(world, "TicketTray", Vector3.new(2.2, 0.15, 1.2), CFrame.new(-8.8, 2.05, -14.9), Color3.fromRGB(180, 140, 60), Enum.Material.Metal)
	part(world, "Stamp", Vector3.new(0.6, 1, 0.6), CFrame.new(-6.4, 2.3, -14.9), Color3.fromRGB(120, 30, 30), Enum.Material.Metal)

	local mirrorFrame = part(world, "MirrorFrame", Vector3.new(2.2, 2.8, 0.2), CFrame.new(-10.6, 3.3, -15), Color3.fromRGB(160, 120, 55), Enum.Material.Metal)
	mirrorFrame.CanCollide = false
	local mirrorGlass = part(world, "MirrorGlass", Vector3.new(1.8, 2.4, 0.06), CFrame.new(-10.6, 3.3, -15.1), Color3.fromRGB(180, 210, 230), Enum.Material.Glass, 0.25, false)
	mirrorGlass.CanCollide = false

	local lamp = part(world, "DeskLamp", Vector3.new(0.5, 0.9, 0.5), CFrame.new(-5.6, 2.9, -15), Color3.fromRGB(255, 210, 140), Enum.Material.Neon)
	lamp.CanCollide = false
	addPointLight(lamp, Color3.fromRGB(255, 190, 110), 1.6, 16)

	local moon = part(world, "Moon", Vector3.new(34, 34, 34), CFrame.new(130, 95, -180), Color3.fromRGB(230, 235, 255), Enum.Material.Neon, 0, false)
	moon.Shape = Enum.PartType.Ball
	moon.CanCollide = false

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "ConductorSpawn"
	spawn.Size = Vector3.new(7, 1, 7)
	spawn.CFrame = CFrame.lookAt(Vector3.new(-8, 1.5, -18), Vector3.new(-8, 1.5, -12))
	spawn.Anchored = true
	spawn.CanCollide = true
	spawn.Transparency = 1
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = world
end

function WorldBuilder.build()
	local legacyBaseplate = Workspace:FindFirstChild("Baseplate")
	if legacyBaseplate and legacyBaseplate:IsA("BasePart") then
		legacyBaseplate:Destroy()
	end

	local old = Workspace:FindFirstChild(WORLD_NAME)
	if old then
		old:Destroy()
	end

	local oldPassengers = Workspace:FindFirstChild(PASSENGER_FOLDER)
	if oldPassengers then
		oldPassengers:Destroy()
	end

	local world = Instance.new("Folder")
	world.Name = WORLD_NAME

	part(world, "Baseplate", Vector3.new(260, 2, 260), CFrame.new(0, -1, 0), Color3.fromRGB(45, 48, 52), Enum.Material.Slate)
	buildStation(world)
	buildTrain(world)

	world.Parent = Workspace
	buildLighting()

	local passengers = Instance.new("Folder")
	passengers.Name = PASSENGER_FOLDER
	passengers.Parent = Workspace
end

function WorldBuilder.clearPassengers()
	local folder = Workspace:FindFirstChild(PASSENGER_FOLDER)
	if folder then
		folder:Destroy()
	end
end

local function createPassengerModel(data)
	local model = Instance.new("Model")
	model.Name = "Passenger_" .. data.id

	local skin = data.appearance.skinColor
	local shirt = data.appearance.shirtColor
	local pants = data.appearance.pantsColor
	local hat = data.appearance.hatColor

	local torso = part(model, "Torso", Vector3.new(2, 2, 1), CFrame.new(0, 3, 0), shirt, Enum.Material.Fabric, 0, false)
	model.PrimaryPart = torso
	part(model, "Head", Vector3.new(1.5, 1.5, 1.5), CFrame.new(0, 4.6, 0), skin, Enum.Material.SmoothPlastic, 0, false)
	part(model, "Hat", Vector3.new(1.7, 0.4, 1.7), CFrame.new(0, 5.5, 0), hat, Enum.Material.Fabric, 0, false)
	part(model, "LeftArm", Vector3.new(0.7, 2, 0.7), CFrame.new(-1.4, 3.1, 0), shirt, Enum.Material.Fabric, 0, false)
	part(model, "RightArm", Vector3.new(0.7, 2, 0.7), CFrame.new(1.4, 3.1, 0), shirt, Enum.Material.Fabric, 0, false)
	part(model, "LeftLeg", Vector3.new(0.8, 2, 0.8), CFrame.new(-0.5, 1.2, 0), pants, Enum.Material.Fabric, 0, false)
	part(model, "RightLeg", Vector3.new(0.8, 2, 0.8), CFrame.new(0.5, 1.2, 0), pants, Enum.Material.Fabric, 0, false)
	part(model, "LeftShoe", Vector3.new(0.9, 0.35, 1.1), CFrame.new(-0.5, 0.2, -0.15), Color3.fromRGB(35, 30, 30), Enum.Material.SmoothPlastic, 0, false)
	part(model, "RightShoe", Vector3.new(0.9, 0.35, 1.1), CFrame.new(0.5, 0.2, -0.15), Color3.fromRGB(35, 30, 30), Enum.Material.SmoothPlastic, 0, false)

	local shadowX = data.shadowWrong and 1.8 or 0
	local shadowZ = data.shadowWrong and 0.8 or 0
	local shadow = part(model, "Shadow", Vector3.new(2.4, 0.04, 1.4), CFrame.new(shadowX, -2.97, shadowZ), Color3.fromRGB(5, 5, 8), Enum.Material.SmoothPlastic, 0.55, false)
	shadow.CanCollide = false

	part(model, "LeftEye", Vector3.new(0.18, 0.18, 0.08), CFrame.new(-0.3, 4.78, -0.77), Color3.fromRGB(20, 20, 20), Enum.Material.SmoothPlastic, 0, false)
	part(model, "RightEye", Vector3.new(0.18, 0.18, 0.08), CFrame.new(0.3, 4.78, -0.77), Color3.fromRGB(20, 20, 20), Enum.Material.SmoothPlastic, 0, false)
	part(model, "Mouth", Vector3.new(0.5, 0.08, 0.08), CFrame.new(0, 4.35, -0.77), Color3.fromRGB(80, 30, 40), Enum.Material.SmoothPlastic, 0, false)

	if data.extraFinger then
		part(model, "ExtraFinger", Vector3.new(0.14, 0.45, 0.14), CFrame.new(1.72, 2.45, -0.15), skin, Enum.Material.SmoothPlastic, 0, false)
	end

	billboard(model.PrimaryPart, data.name, Vector3.new(0, 2.6, 0), UDim2.fromOffset(220, 44))

	return model
end

function WorldBuilder.spawnPassenger(data)
	local folder = Workspace:FindFirstChild(PASSENGER_FOLDER)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = PASSENGER_FOLDER
		folder.Parent = Workspace
	end

	local model = createPassengerModel(data)
	model:PivotTo(WorldBuilder.startCFrame)
	model.Parent = folder
	return model
end

function WorldBuilder.movePassenger(model, targetCFrame, duration)
	if not model or not model.PrimaryPart then
		return
	end

	local value = Instance.new("CFrameValue")
	value.Value = model:GetPivot()

	local tween = TweenService:Create(
		value,
		TweenInfo.new(duration or 1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Value = targetCFrame }
	)

	local connection = value.Changed:Connect(function()
		if model.Parent then
			model:PivotTo(value.Value)
		end
	end)

	tween:Play()
	tween.Completed:Wait()
	connection:Disconnect()
	value:Destroy()
end

function WorldBuilder.removePassenger(model)
	if model then
		model:Destroy()
	end
end

return WorldBuilder
]]></ProtectedString>
